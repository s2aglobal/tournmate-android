<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no longer covers device-to-device transfer.
     Exclude everything so the signed-in session and local inbox never move to
     another device (matches iOS keychain items that don't restore cross-device). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
